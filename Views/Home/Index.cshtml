@model List<Scheme>
@inject SignInManager<ApplicationUser> SignInManager
@{
    ViewData["Title"] = "Home";
    var signedIn = SignInManager.IsSignedIn(User);
}

<section class="gov-hero p-4 p-md-5 mb-4">
    <div class="row align-items-center">
        <div class="col-lg-8">
            <h1 class="fw-bold mb-2">Subsidy &amp; Grievance Portal</h1>
            <p class="lead mb-3">
                A single-window platform for entrepreneurs to apply for government schemes,
                upload documents, track application status, and raise grievances &mdash;
                modelled on a District Industries Centre (DIC).
            </p>
            <div class="d-flex flex-wrap gap-2">
                <a asp-controller="Schemes" asp-action="Index" class="btn btn-light">
                    <i class="bi bi-collection me-1"></i> Browse schemes
                </a>
                @if (!signedIn)
                {
                    <a asp-controller="Account" asp-action="Register" class="btn btn-outline-light">
                        <i class="bi bi-person-plus me-1"></i> Register as applicant
                    </a>
                }
                else if (User.IsInRole(Roles.Applicant))
                {
                    <a asp-controller="Applications" asp-action="Index" class="btn btn-outline-light">
                        <i class="bi bi-folder2-open me-1"></i> My applications
                    </a>
                }
            </div>
        </div>
    </div>
</section>

<div class="row g-4 mb-2">
    <div class="col-md-4">
        <div class="card h-100">
            <div class="card-body">
                <h2 class="h6"><i class="bi bi-1-circle text-primary me-1"></i> Apply</h2>
                <p class="text-muted small mb-0">Register, complete your business profile once, choose a scheme, and submit with a supporting PDF.</p>
            </div>
        </div>
    </div>
    <div class="col-md-4">
        <div class="card h-100">
            <div class="card-body">
                <h2 class="h6"><i class="bi bi-2-circle text-primary me-1"></i> Track</h2>
                <p class="text-muted small mb-0">Follow your application through Submitted, Under Review and the final decision, with officer remarks.</p>
            </div>
        </div>
    </div>
    <div class="col-md-4">
        <div class="card h-100">
            <div class="card-body">
                <h2 class="h6"><i class="bi bi-3-circle text-primary me-1"></i> Resolve</h2>
                <p class="text-muted small mb-0">Raise a grievance, receive a unique ticket number, and track it to resolution.</p>
            </div>
        </div>
    </div>
</div>

<div class="d-flex justify-content-between align-items-end mt-5 mb-3">
    <h2 class="h4 mb-0">Featured schemes</h2>
    <a asp-controller="Schemes" asp-action="Index" class="small">View all &rarr;</a>
</div>

@if (Model.Count == 0)
{
    <p class="text-muted">No active schemes are published yet.</p>
}
else
{
    <div class="row g-4">
        @foreach (var scheme in Model)
        {
            <div class="col-md-4">
                <div class="card h-100">
                    <div class="card-body d-flex flex-column">
                        <div class="scheme-dept mb-1">@scheme.Department</div>
                        <h3 class="h5">@scheme.Name</h3>
                        <p class="text-muted small flex-grow-1">
                            @(scheme.Description.Length > 140 ? scheme.Description[..140] + "…" : scheme.Description)
                        </p>
                        <a asp-controller="Schemes" asp-action="Details" asp-route-id="@scheme.Id"
                           class="btn btn-sm btn-outline-primary mt-2 align-self-start">Details</a>
                    </div>
                </div>
            </div>
        }
    </div>
}
