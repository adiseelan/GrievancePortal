@model List<Scheme>
@{
    ViewData["Title"] = "Schemes";
    var isApplicant = User.IsInRole(Roles.Applicant);
}
<div class="d-flex justify-content-between align-items-center mb-3">
    <h1 class="h3 mb-0">Government schemes</h1>
</div>

@if (Model.Count == 0)
{
    <div class="alert alert-light border">No active schemes are available right now.</div>
}
else
{
    <div class="row g-4">
        @foreach (var s in Model)
        {
            <div class="col-md-6 col-lg-4">
                <div class="card h-100">
                    <div class="card-body d-flex flex-column">
                        <div class="scheme-dept mb-1">@s.Department</div>
                        <h2 class="h5">@s.Name</h2>
                        <p class="text-muted small flex-grow-1">
                            @(s.Description.Length > 160 ? s.Description[..160] + "…" : s.Description)
                        </p>
                        <div class="d-flex gap-2 mt-2">
                            <a asp-action="Details" asp-route-id="@s.Id" class="btn btn-sm btn-outline-primary">Details</a>
                            @if (isApplicant)
                            {
                                <a asp-controller="Applications" asp-action="Apply" asp-route-schemeId="@s.Id"
                                   class="btn btn-sm btn-primary">Apply</a>
                            }
                        </div>
                    </div>
                </div>
            </div>
        }
    </div>
}
