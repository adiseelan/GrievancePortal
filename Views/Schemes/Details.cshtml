@model Scheme
@{
    ViewData["Title"] = Model.Name;
    var isApplicant = User.IsInRole(Roles.Applicant);
    var isAdmin = User.IsInRole(Roles.Admin);
}
<nav aria-label="breadcrumb">
    <ol class="breadcrumb small">
        <li class="breadcrumb-item"><a asp-action="Index">Schemes</a></li>
        <li class="breadcrumb-item active" aria-current="page">@Model.Name</li>
    </ol>
</nav>

<div class="card">
    <div class="card-body p-4">
        <div class="d-flex justify-content-between align-items-start flex-wrap gap-2">
            <div>
                <div class="scheme-dept mb-1">@Model.Department</div>
                <h1 class="h3 mb-0">@Model.Name</h1>
            </div>
            @if (!Model.IsActive)
            {
                <span class="badge text-bg-secondary">Inactive</span>
            }
        </div>

        <hr />

        <h2 class="h6 text-uppercase text-muted">About this scheme</h2>
        <p style="white-space: pre-line;">@Model.Description</p>

        <h2 class="h6 text-uppercase text-muted mt-4">Eligibility</h2>
        <p style="white-space: pre-line;">@Model.Eligibility</p>

        <div class="d-flex gap-2 mt-4">
            @if (isApplicant && Model.IsActive)
            {
                <a asp-controller="Applications" asp-action="Apply" asp-route-schemeId="@Model.Id" class="btn btn-primary">
                    <i class="bi bi-pencil-square me-1"></i> Apply for this scheme
                </a>
            }
            else if (!User.Identity!.IsAuthenticated)
            {
                <a asp-controller="Account" asp-action="Register" class="btn btn-primary">Register to apply</a>
            }
            @if (isAdmin)
            {
                <a asp-action="Edit" asp-route-id="@Model.Id" class="btn btn-outline-secondary">Edit scheme</a>
            }
        </div>
    </div>
</div>
