@model List<Grievance>
@{
    ViewData["Title"] = "My grievances";
}
<div class="d-flex justify-content-between align-items-center mb-3">
    <h1 class="h3 mb-0">My grievances</h1>
    <a asp-action="Create" class="btn btn-primary"><i class="bi bi-plus-lg me-1"></i> Raise a grievance</a>
</div>

@if (Model.Count == 0)
{
    <div class="alert alert-light border">You haven't raised any grievance yet.</div>
}
else
{
    <div class="card">
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
                <thead class="table-light">
                    <tr>
                        <th>Ticket no.</th>
                        <th>Subject</th>
                        <th>Status</th>
                        <th>Raised</th>
                        <th class="text-end">Action</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var g in Model)
                    {
                        <tr>
                            <td class="font-monospace small">@g.TicketNumber</td>
                            <td>@g.Subject</td>
                            <td><partial name="_StatusBadge" model="@g.Status.ToString()" /></td>
                            <td class="small text-muted">@g.CreatedAt.ToLocalTime().ToString("dd MMM yyyy")</td>
                            <td class="text-end">
                                <a asp-action="Details" asp-route-id="@g.Id" class="btn btn-sm btn-outline-primary">Open</a>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
}
