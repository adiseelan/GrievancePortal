@model ProfileFormModel
@{
    ViewData["Title"] = "Business profile";
}
<div class="row justify-content-center">
    <div class="col-lg-9">
        <div class="d-flex justify-content-between align-items-center mb-3">
            <h1 class="h3 mb-0">My business profile</h1>
            @if (Model.HasExistingProfile)
            {
                <span class="badge text-bg-success"><i class="bi bi-check-circle me-1"></i>Saved</span>
            }
        </div>

        <p class="text-muted">
            These details are used on every scheme application. Fill them in once; you can update them anytime.
        </p>

        <div class="card">
            <div class="card-body p-4">
                <form asp-action="Edit" method="post">
                    <div asp-validation-summary="ModelOnly" class="text-danger small mb-2"></div>

                    <div class="row">
                        <div class="col-md-6 mb-3">
                            <label asp-for="BusinessName" class="form-label required-star"></label>
                            <input asp-for="BusinessName" class="form-control" />
                            <span asp-validation-for="BusinessName" class="text-danger small"></span>
                        </div>
                        <div class="col-md-6 mb-3">
                            <label asp-for="OwnerName" class="form-label required-star"></label>
                            <input asp-for="OwnerName" class="form-control" />
                            <span asp-validation-for="OwnerName" class="text-danger small"></span>
                        </div>
                    </div>

                    <div class="mb-3">
                        <label asp-for="Address" class="form-label required-star"></label>
                        <textarea asp-for="Address" class="form-control" rows="2"></textarea>
                        <span asp-validation-for="Address" class="text-danger small"></span>
                    </div>

                    <div class="row">
                        <div class="col-md-5 mb-3">
                            <label asp-for="District" class="form-label required-star"></label>
                            <input asp-for="District" class="form-control" />
                            <span asp-validation-for="District" class="text-danger small"></span>
                        </div>
                        <div class="col-md-3 mb-3">
                            <label asp-for="Pincode" class="form-label required-star"></label>
                            <input asp-for="Pincode" class="form-control" inputmode="numeric"
                                   maxlength="6" placeholder="6-digit PIN" />
                            <span asp-validation-for="Pincode" class="text-danger small"></span>
                        </div>
                        <div class="col-md-4 mb-3">
                            <label asp-for="Phone" class="form-label required-star"></label>
                            <input asp-for="Phone" class="form-control" type="tel" inputmode="numeric"
                                   maxlength="10" placeholder="10-digit mobile" />
                            <span asp-validation-for="Phone" class="text-danger small"></span>
                        </div>
                    </div>

                    <div class="row">
                        <div class="col-md-6 mb-3">
                            <label asp-for="UdyamNumber" class="form-label"></label>
                            <input asp-for="UdyamNumber" class="form-control" placeholder="UDYAM-TN-00-1234567" />
                            <div class="form-text">Leave blank if not registered. Format: UDYAM-TN-00-1234567.</div>
                            <span asp-validation-for="UdyamNumber" class="text-danger small"></span>
                        </div>
                        <div class="col-md-6 mb-3">
                            <label asp-for="BusinessType" class="form-label"></label>
                            <input asp-for="BusinessType" class="form-control" placeholder="e.g. Manufacturing, Services, Trading" />
                            <span asp-validation-for="BusinessType" class="text-danger small"></span>
                        </div>
                    </div>

                    <div class="d-flex gap-2">
                        <button type="submit" class="btn btn-primary">Save profile</button>
                        <a asp-controller="Schemes" asp-action="Index" class="btn btn-outline-secondary">Browse schemes</a>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
