@inject SignInManager<ApplicationUser> SignInManager
@inject UserManager<ApplicationUser> UserManager
@{
    var signedIn = SignInManager.IsSignedIn(User);
    ApplicationUser? currentUser = signedIn ? await UserManager.GetUserAsync(User) : null;
    var isAdmin = User.IsInRole(Roles.Admin);
    var isOfficer = User.IsInRole(Roles.Officer);
    var isApplicant = User.IsInRole(Roles.Applicant);
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Subsidy & Grievance Portal</title>
    <link rel="stylesheet"
          href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" />
    <link rel="stylesheet"
          href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body class="d-flex flex-column min-vh-100">
    <header>
        <nav class="navbar navbar-expand-lg navbar-dark gov-navbar">
            <div class="container">
                <a class="navbar-brand d-flex align-items-center gap-2" asp-controller="Home" asp-action="Index">
                    <i class="bi bi-bank2"></i>
                    <span>Subsidy & Grievance Portal</span>
                </a>
                <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#mainNav"
                        aria-controls="mainNav" aria-expanded="false" aria-label="Toggle navigation">
                    <span class="navbar-toggler-icon"></span>
                </button>
                <div class="collapse navbar-collapse" id="mainNav">
                    <ul class="navbar-nav me-auto mb-2 mb-lg-0">
                        <li class="nav-item">
                            <a class="nav-link" asp-controller="Home" asp-action="Index">Home</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link" asp-controller="Schemes" asp-action="Index">Schemes</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link" asp-controller="Grievances" asp-action="Track">Track grievance</a>
                        </li>

                        @if (isApplicant)
                        {
                            <li class="nav-item">
                                <a class="nav-link" asp-controller="Applications" asp-action="Index">My applications</a>
                            </li>
                            <li class="nav-item">
                                <a class="nav-link" asp-controller="Grievances" asp-action="Index">My grievances</a>
                            </li>
                            <li class="nav-item">
                                <a class="nav-link" asp-controller="Profile" asp-action="Edit">My profile</a>
                            </li>
                        }

                        @if (isOfficer || isAdmin)
                        {
                            <li class="nav-item">
                                <a class="nav-link" asp-controller="Officer" asp-action="Dashboard">Officer desk</a>
                            </li>
                        }

                        @if (isAdmin)
                        {
                            <li class="nav-item dropdown">
                                <a class="nav-link dropdown-toggle" href="#" role="button" data-bs-toggle="dropdown" aria-expanded="false">
                                    Admin
                                </a>
                                <ul class="dropdown-menu">
                                    <li><a class="dropdown-item" asp-controller="Admin" asp-action="Dashboard">Dashboard</a></li>
                                    <li><a class="dropdown-item" asp-controller="Schemes" asp-action="Manage">Manage schemes</a></li>
                                    <li><a class="dropdown-item" asp-controller="Admin" asp-action="Users">Users</a></li>
                                    <li><a class="dropdown-item" asp-controller="Admin" asp-action="Reports">Reports</a></li>
                                </ul>
                            </li>
                        }
                    </ul>

                    <ul class="navbar-nav">
                        @if (signedIn)
                        {
                            <li class="nav-item d-flex align-items-center text-white-50 me-3 small">
                                <i class="bi bi-person-circle me-1"></i>
                                <span>@(currentUser?.FullName ?? User.Identity?.Name)</span>
                            </li>
                            <li class="nav-item">
                                <form asp-controller="Account" asp-action="Logout" method="post" class="d-inline">
                                    <button type="submit" class="btn btn-sm btn-outline-light">Sign out</button>
                                </form>
                            </li>
                        }
                        else
                        {
                            <li class="nav-item">
                                <a class="btn btn-sm btn-outline-light me-2" asp-controller="Account" asp-action="Login">Sign in</a>
                            </li>
                            <li class="nav-item">
                                <a class="btn btn-sm btn-light" asp-controller="Account" asp-action="Register">Register</a>
                            </li>
                        }
                    </ul>
                </div>
            </div>
        </nav>
    </header>

    <main class="container my-4 flex-grow-1">
        @await Html.PartialAsync("_Alerts")
        @RenderBody()
    </main>

    <footer class="gov-footer mt-auto py-3">
        <div class="container d-flex flex-wrap justify-content-between align-items-center small">
            <span>&copy; @DateTime.Now.Year Subsidy &amp; Grievance Portal</span>
            <span class="text-white-50">A single-window e-governance demo &middot; District Industries Centre model</span>
        </div>
    </footer>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
