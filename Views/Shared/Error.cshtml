@model ErrorViewModel
@{
    ViewData["Title"] = Model.Title;
}
<div class="row justify-content-center">
    <div class="col-md-8 col-lg-6 text-center py-5">
        <div class="display-1 fw-bold text-muted">@(Model.StatusCode?.ToString() ?? "!")</div>
        <h1 class="h3 mt-2">@Model.Title</h1>
        <p class="text-muted">@Model.Message</p>
        <a asp-controller="Home" asp-action="Index" class="btn btn-primary mt-2">
            <i class="bi bi-house-door me-1"></i> Back to home
        </a>
        @if (Model.ShowRequestId)
        {
            <p class="text-muted small mt-4">Reference: <code>@Model.RequestId</code></p>
        }
    </div>
</div>
