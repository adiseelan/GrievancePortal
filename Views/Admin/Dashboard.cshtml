@{
    ViewData["Title"] = "Admin dashboard";
}
<h1 class="h3 mb-3">Admin dashboard</h1>

<div class="row g-3 mb-4">
    <div class="col-6 col-md-3">
        <div class="stat-tile p-3"><div class="stat-value">@ViewBag.TotalUsers</div><div class="stat-label">Users</div></div>
    </div>
    <div class="col-6 col-md-3">
        <div class="stat-tile p-3"><div class="stat-value">@ViewBag.ActiveSchemes / @ViewBag.TotalSchemes</div><div class="stat-label">Active schemes</div></div>
    </div>
    <div class="col-6 col-md-3">
        <div class="stat-tile p-3"><div class="stat-value">@ViewBag.TotalApplications</div><div class="stat-label">Applications (@ViewBag.PendingApplications pending)</div></div>
    </div>
    <div class="col-6 col-md-3">
        <div class="stat-tile p-3"><div class="stat-value">@ViewBag.TotalGrievances</div><div class="stat-label">Grievances (@ViewBag.OpenGrievances open)</div></div>
    </div>
</div>

<div class="row g-4">
    <div class="col-md-6 col-lg-3">
        <a asp-action="Users" class="card h-100 text-decoration-none text-reset">
            <div class="card-body"><i class="bi bi-people fs-3 text-primary"></i>
                <h2 class="h6 mt-2 mb-0">Manage users</h2>
                <p class="text-muted small mb-0">Assign roles to applicants, officers and admins.</p>
            </div>
        </a>
    </div>
    <div class="col-md-6 col-lg-3">
        <a asp-controller="Schemes" asp-action="Manage" class="card h-100 text-decoration-none text-reset">
            <div class="card-body"><i class="bi bi-collection fs-3 text-primary"></i>
                <h2 class="h6 mt-2 mb-0">Manage schemes</h2>
                <p class="text-muted small mb-0">Create, edit, activate or deactivate schemes.</p>
            </div>
        </a>
    </div>
    <div class="col-md-6 col-lg-3">
        <a asp-action="Reports" class="card h-100 text-decoration-none text-reset">
            <div class="card-body"><i class="bi bi-bar-chart fs-3 text-primary"></i>
                <h2 class="h6 mt-2 mb-0">Reports</h2>
                <p class="text-muted small mb-0">Status counts with CSV export.</p>
            </div>
        </a>
    </div>
    <div class="col-md-6 col-lg-3">
        <a asp-controller="Officer" asp-action="Dashboard" class="card h-100 text-decoration-none text-reset">
            <div class="card-body"><i class="bi bi-inboxes fs-3 text-primary"></i>
                <h2 class="h6 mt-2 mb-0">Officer desk</h2>
                <p class="text-muted small mb-0">Act on pending applications and grievances.</p>
            </div>
        </a>
    </div>
</div>
