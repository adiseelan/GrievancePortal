@model List<UserRow>
@{
    ViewData["Title"] = "Users";
    var allRoles = ViewBag.AllRoles as string[] ?? Array.Empty<string>();
}
<h1 class="h3 mb-3">Users</h1>
<p class="text-muted">Assign a primary role to each user. Officers review applications and grievances; admins manage everything.</p>

<div class="card">
    <div class="table-responsive">
        <table class="table table-hover align-middle mb-0">
            <thead class="table-light">
                <tr>
                    <th>Name</th>
                    <th>Email</th>
                    <th>Current role(s)</th>
                    <th>Joined</th>
                    <th style="min-width: 260px;">Set role</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var u in Model)
                {
                    <tr>
                        <td class="fw-semibold">@u.FullName</td>
                        <td class="small">@u.Email</td>
                        <td>
                            @if (u.RolesList.Count == 0)
                            {
                                <span class="text-muted small">none</span>
                            }
                            else
                            {
                                foreach (var r in u.RolesList)
                                {
                                    <span class="badge text-bg-light border me-1">@r</span>
                                }
                            }
                        </td>
                        <td class="small text-muted">@u.CreatedAt.ToLocalTime().ToString("dd MMM yyyy")</td>
                        <td>
                            <form asp-action="SetRole" method="post" class="d-flex gap-2">
                                <input type="hidden" name="UserId" value="@u.Id" />
                                <select name="Role" class="form-select form-select-sm">
                                    @foreach (var role in allRoles)
                                    {
                                        if (u.RolesList.Contains(role))
                                        {
                                            <option value="@role" selected>@role</option>
                                        }
                                        else
                                        {
                                            <option value="@role">@role</option>
                                        }
                                    }
                                </select>
                                <button type="submit" class="btn btn-sm btn-outline-primary">Apply</button>
                            </form>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>
