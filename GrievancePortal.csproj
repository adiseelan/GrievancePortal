<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>GrievancePortal</RootNamespace>
    <InvariantGlobalization>true</InvariantGlobalization>
  </PropertyGroup>

  <ItemGroup>
    <!-- Identity -->
    <PackageReference Include="Microsoft.AspNetCore.Identity.EntityFrameworkCore" Version="10.0.3" />

    <!-- EF Core: SQLite (local dev) -->
    <PackageReference Include="Microsoft.EntityFrameworkCore.Sqlite" Version="10.0.3" />

    <!-- EF Core: design-time tooling (migrations) -->
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design" Version="10.0.3">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>

    <!-- EF Core: PostgreSQL (production). Only used when DatabaseProvider=Postgres. -->
    <PackageReference Include="Npgsql.EntityFrameworkCore.PostgreSQL" Version="10.0.3" />

    <!-- Force the patched build of this transitively-referenced package so the
         older 9.0.0 version (flagged by NU1902/NU1903) is never restored. -->
    <PackageReference Include="System.Security.Cryptography.Pkcs" Version="10.0.3" />
  </ItemGroup>

  <ItemGroup>
    <!-- SQLitePCLRaw.lib.e_sqlite3 2.1.11 is the newest published version; there is
         no fixed release to upgrade to yet (tracked at dotnet/efcore#38547). It is a
         transitive dependency of the local-development SQLite provider ONLY and is
         not referenced by the PostgreSQL production build. Suppress just this single
         advisory (not all audit warnings) and revisit when a fix is published. -->
    <NuGetAuditSuppress Include="https://github.com/advisories/GHSA-2m69-gcr7-jv3q" />
  </ItemGroup>

  <ItemGroup>
    <!-- Keep the uploads folder in the publish output but never serve it statically. -->
    <None Include="App_Data/uploads/.gitkeep" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
